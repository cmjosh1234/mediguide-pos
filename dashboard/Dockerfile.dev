# syntax=docker/dockerfile:1.7
# Local-development image for the dashboard: runs the Next.js dev server
# (Turbopack, hot module reload) against a bind-mounted source tree instead
# of the compiled standalone build in Dockerfile. Not used in production.

FROM oven/bun:1.3.14-alpine AS development

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN mkdir -p /app/.next && chown -R bun:bun /app
USER bun

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 \
  CMD wget -qO- "http://127.0.0.1:3000${NEXT_PUBLIC_DASHBOARD_BASE_PATH:-/admin}" >/dev/null || exit 1

CMD ["bun", "run", "dev"]
