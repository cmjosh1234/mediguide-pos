require "fileutils"
require "uri"

opt_out_usage
default_platform(:android)

# Fastlane restores its original directory after evaluating this file. Run lane
# work inside the mobile package instead of relying on the caller's directory.
def within_mobile_project
  root = ENV.fetch("MOBILE_PROJECT_ROOT", File.expand_path("..", __dir__))
  UI.user_error!("Mobile pubspec.yaml not found under #{root}") unless File.file?(File.join(root, "pubspec.yaml"))

  Dir.chdir(root) { yield }
end

def require_environment!(*names)
  missing = names.select { |name| ENV[name].to_s.strip.empty? }
  UI.user_error!("Missing required environment variables: #{missing.join(', ')}") unless missing.empty?
end

def release_notes
  explicit = ENV["RELEASE_NOTES"].to_s.strip
  return explicit unless explicit.empty?

  root = ENV.fetch("MOBILE_PROJECT_ROOT", File.expand_path("..", __dir__))
  version = File.read(File.join(root, "pubspec.yaml")).match(/^version:\s*([^+\s]+)\+/)&.captures&.first
  notes = File.join(root, "..", "docs", "releases", "v#{version}", "mobile.md")
  return File.read(notes).strip if mobile_flavor == "production" && File.file?(notes)

  tag = ENV.fetch("GITHUB_REF_NAME", "local build")
  revision = ENV.fetch("GITHUB_SHA", "unknown")[0, 12]
  "MediGuide #{tag} (#{revision})"
end

def flutter_defines
  defines = [
    "--dart-define=MEDIGUIDE_API_BASE_URL=#{ENV.fetch('MOBILE_API_BASE_URL')}",
    "--dart-define=MEDIGUIDE_FLAVOR=#{mobile_flavor}",
    "--dart-define=MEDIGUIDE_DEBUG_TOOLS_ENABLED=#{mobile_flavor != 'production'}"
  ]
  config_file = ENV["FIREBASE_DART_DEFINES_FILE"].to_s.strip
  defines << "--dart-define-from-file=#{config_file}" unless config_file.empty?
  defines
end

def mobile_flavor
  ENV.fetch("MOBILE_FLAVOR", "production")
end

def flutter_target
  "lib/main_#{mobile_flavor}.dart"
end

def flutter_version_args
  build_name = ENV["MOBILE_BUILD_NAME"].to_s.strip
  build_number = ENV["MOBILE_BUILD_NUMBER"].to_s.strip
  unless build_number.empty? || build_number.match?(/\A[1-9][0-9]*\z/)
    UI.user_error!("MOBILE_BUILD_NUMBER must be a positive integer")
  end

  args = []
  args << "--build-name=#{build_name}" unless build_name.empty?
  args << "--build-number=#{build_number}" unless build_number.empty?
  args
end

def enforce_artifact_size!(path:, max_bytes:, label:)
  bytes = File.size(path)
  UI.message("#{label}: #{bytes} bytes")
  return if bytes <= max_bytes

  UI.user_error!("#{label} exceeds the #{max_bytes / 1024 / 1024} MiB release budget")
end

def firebase_distribution(binary:, app_id:)
  require_environment!("GOOGLE_APPLICATION_CREDENTIALS")
  binary_path = File.expand_path(binary)
  UI.user_error!("Firebase distribution binary not found at #{binary_path}") unless File.file?(binary_path)

  firebase_app_distribution(
    app: app_id,
    firebase_cli_token: nil,
    service_credentials_file: ENV.fetch("GOOGLE_APPLICATION_CREDENTIALS"),
    groups: ENV.fetch("FIREBASE_TESTER_GROUPS", "mediguide-testers"),
    testers: ENV["FIREBASE_TESTERS"],
    release_notes: release_notes,
    android_artifact_path: binary_path.end_with?(".apk", ".aab") ? binary_path : nil,
    ipa_path: binary_path.end_with?(".ipa") ? binary_path : nil
  )
end

def app_store_api_key
  require_environment!(
    "APP_STORE_CONNECT_KEY_ID",
    "APP_STORE_CONNECT_ISSUER_ID",
    "APP_STORE_CONNECT_KEY_FILE"
  )
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_filepath: ENV.fetch("APP_STORE_CONNECT_KEY_FILE"),
    duration: 1_200,
    in_house: false
  )
end

platform :android do
  private_lane :build_firebase_apk do
    within_mobile_project do
      require_environment!("MOBILE_API_BASE_URL")
      sh("dart", "run", "build_runner", "build", "--delete-conflicting-outputs")
      sh("flutter", "build", "apk", "--release", "--flavor", mobile_flavor, "--target", flutter_target, *flutter_version_args, *flutter_defines)
    end
  end

  desc "Build a signed Android APK and AAB"
  lane :build_release do
    within_mobile_project do
      require_environment!("MOBILE_API_BASE_URL")
      UI.user_error!("Release signing requires android/key.properties") unless File.file?("android/key.properties")
      if mobile_flavor == "production"
        uri = URI.parse(ENV.fetch("MOBILE_API_BASE_URL"))
        UI.user_error!("Production API must use HTTPS") unless uri.scheme == "https" && uri.host && uri.userinfo.nil?
      end
      sh("dart", "run", "build_runner", "build", "--delete-conflicting-outputs")
      sh("flutter", "build", "apk", "--release", "--flavor", mobile_flavor, "--target", flutter_target, *flutter_version_args, *flutter_defines)
      sh(
        "flutter", "build", "appbundle", "--release",
        "--target-platform", "android-arm,android-arm64",
        "--flavor", mobile_flavor,
        "--target", flutter_target,
        *flutter_version_args,
        *flutter_defines
      )
    end
  end

  desc "Upload an existing signed Android APK to Firebase App Distribution"
  lane :firebase do |options|
    within_mobile_project do
      require_environment!("FIREBASE_ANDROID_APP_ID")
      apk = options[:apk] || ENV.fetch("ANDROID_APK_PATH", "build/app/outputs/flutter-apk/app-#{mobile_flavor}-release.apk")
      UI.user_error!("Android APK not found at #{apk}") unless File.file?(apk)
      firebase_distribution(binary: apk, app_id: ENV.fetch("FIREBASE_ANDROID_APP_ID"))
    end
  end

  desc "Build Android and upload the APK to Firebase App Distribution"
  lane :firebase_release do
    build_firebase_apk
    firebase
  end

  desc "Upload an existing Android App Bundle as a draft production release"
  lane :play_store do |options|
    within_mobile_project do
      require_environment!("GOOGLE_PLAY_SERVICE_ACCOUNT_FILE")
      UI.user_error!("Google Play uploads require the production flavor") unless mobile_flavor == "production"
      UI.user_error!("Unexpected Google Play package") unless ENV.fetch("ANDROID_PACKAGE_NAME", "com.mediguide.ug") == "com.mediguide.ug"
      build = ENV.fetch("MOBILE_BUILD_NUMBER")
      changelog = "fastlane/metadata/android/en-US/changelogs/#{build}.txt"
      UI.user_error!("Missing versioned Play changelog") unless File.file?(changelog) && File.read(changelog).strip.length.between?(1, 500)
      # This lane creates a draft only; policy and device evidence are checked
      # separately before any later rollout or promotion.
      sh("python3", "tool/check_play_store.py")
      aab = File.expand_path(
        options[:aab] || ENV["ANDROID_AAB_PATH"] || "build/app/outputs/bundle/#{mobile_flavor}Release/app-#{mobile_flavor}-release.aab"
      )
      UI.user_error!("Android App Bundle not found at #{aab}") unless File.file?(aab)

      upload_to_play_store(
        json_key: ENV.fetch("GOOGLE_PLAY_SERVICE_ACCOUNT_FILE"),
        package_name: ENV.fetch("ANDROID_PACKAGE_NAME", "com.mediguide.ug"),
        aab: aab,
        track: "production",
        release_status: "draft",
        skip_upload_metadata: true,
        skip_upload_changelogs: false,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end
  end

  desc "Update release notes for an existing Google Play production draft"
  lane :play_store_notes do
    within_mobile_project do
      require_environment!("GOOGLE_PLAY_SERVICE_ACCOUNT_FILE", "MOBILE_BUILD_NUMBER")
      build = ENV.fetch("MOBILE_BUILD_NUMBER")
      UI.user_error!("Invalid Play build number") unless build.match?(/\A[1-9][0-9]*\z/)
      notes = "fastlane/metadata/android/en-US/changelogs/#{build}.txt"
      UI.user_error!("Missing versioned Play changelog") unless File.file?(notes) && File.read(notes).strip.length.between?(1, 500)
      upload_to_play_store(
        json_key: ENV.fetch("GOOGLE_PLAY_SERVICE_ACCOUNT_FILE"),
        package_name: "com.mediguide.ug",
        track: "production",
        version_code: build.to_i,
        release_status: "draft",
        skip_upload_aab: true,
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: false,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end
  end

  desc "Build Android and upload a draft production release to Google Play"
  lane :play_store_release do
    build_release
    play_store
  end
end

platform :ios do
  private_lane :build_ipa do |options|
    within_mobile_project do
      require_environment!("MOBILE_API_BASE_URL")
      export_options = options[:export_options]
      output_directory = options[:output_directory]
      require_environment!("APPLE_TEAM_ID")
      UI.user_error!("Export options plist not found at #{export_options}") unless File.file?(export_options)

      sh("dart", "run", "build_runner", "build", "--delete-conflicting-outputs")
      FileUtils.rm_rf("build/ios/ipa")
      sh(
        "flutter", "build", "ipa", "--release",
        "--flavor", mobile_flavor,
        "--target", flutter_target,
        "--export-options-plist=#{File.expand_path(export_options)}",
        "--build-number=#{ENV.fetch('MOBILE_BUILD_NUMBER')}",
        *flutter_defines
      )

      ipa = Dir["build/ios/ipa/*.ipa"].first
      UI.user_error!("Flutter did not produce an IPA") unless ipa
      FileUtils.mkdir_p(output_directory)
      destination = File.join(output_directory, File.basename(ipa))
      FileUtils.cp(ipa, destination)
      enforce_artifact_size!(
        path: destination,
        max_bytes: Integer(ENV.fetch("MAX_IOS_IPA_BYTES", 40 * 1024 * 1024)),
        label: "Signed iOS IPA"
      )
      destination
    end
  end

  desc "Build an Ad Hoc IPA for Firebase App Distribution"
  lane :build_firebase do
    require_environment!("IOS_FIREBASE_EXPORT_OPTIONS_PLIST", "MOBILE_BUILD_NUMBER")
    build_ipa(
      export_options: ENV.fetch("IOS_FIREBASE_EXPORT_OPTIONS_PLIST"),
      output_directory: "build/ios/firebase"
    )
  end

  desc "Upload an existing Ad Hoc IPA to Firebase App Distribution"
  lane :firebase do |options|
    within_mobile_project do
      require_environment!("FIREBASE_IOS_APP_ID")
      ipa = options[:ipa] || ENV["IOS_FIREBASE_IPA_PATH"] || Dir["build/ios/firebase/*.ipa"].first
      UI.user_error!("No Firebase iOS IPA was provided or built") unless ipa && File.file?(ipa)
      firebase_distribution(binary: ipa, app_id: ENV.fetch("FIREBASE_IOS_APP_ID"))
    end
  end

  desc "Build and distribute an Ad Hoc IPA with Firebase App Distribution"
  lane :firebase_release do
    ipa = build_firebase
    firebase(ipa: ipa)
  end

  desc "Build an App Store IPA for TestFlight"
  lane :build_testflight do
    require_environment!("IOS_TESTFLIGHT_EXPORT_OPTIONS_PLIST", "MOBILE_BUILD_NUMBER")
    build_ipa(
      export_options: ENV.fetch("IOS_TESTFLIGHT_EXPORT_OPTIONS_PLIST"),
      output_directory: "build/ios/testflight"
    )
  end

  desc "Upload an existing App Store IPA to TestFlight"
  lane :upload_testflight do |options|
    within_mobile_project do
      ipa = options[:ipa] || ENV["IOS_TESTFLIGHT_IPA_PATH"] || Dir["build/ios/testflight/*.ipa"].first
      UI.user_error!("No TestFlight IPA was provided or built") unless ipa && File.file?(ipa)

      upload_to_testflight(
        api_key: app_store_api_key,
        ipa: ipa,
        changelog: release_notes,
        skip_waiting_for_build_processing: true,
        distribute_external: false
      )
    end
  end

  desc "Build and upload an App Store IPA to TestFlight"
  lane :testflight_release do
    ipa = build_testflight
    upload_testflight(ipa: ipa)
  end


  desc "Upload an existing IPA to App Store Connect without public release"
  lane :app_store do |options|
    within_mobile_project do
      ipa = options[:ipa] || ENV["IOS_APP_STORE_IPA_PATH"] || Dir["build/ios/app-store/*.ipa"].first
      UI.user_error!("No App Store IPA was provided or built") unless ipa && File.file?(ipa)

      upload_to_app_store(
        api_key: app_store_api_key,
        ipa: ipa,
        app_identifier: ENV.fetch("IOS_BUNDLE_IDENTIFIER", "com.omarsoft.mediguide"),
        submit_for_review: false,
        automatic_release: false,
        skip_metadata: true,
        skip_screenshots: true,
        force: true
      )
    end
  end

  desc "Build and upload an App Store production candidate"
  lane :app_store_release do
    require_environment!("IOS_APP_STORE_EXPORT_OPTIONS_PLIST", "MOBILE_BUILD_NUMBER")
    ipa = build_ipa(
      export_options: ENV.fetch("IOS_APP_STORE_EXPORT_OPTIONS_PLIST"),
      output_directory: "build/ios/app-store"
    )
    app_store(ipa: ipa)
  end
end
