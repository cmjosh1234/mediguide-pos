APP_NAME=mediguide-ai-worker
APP_ENV=development
HTTP_PORT=8090

DATABASE_URL=postgresql://mediguide:mediguide@localhost:5432/mediguide
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=mediguide
S3_SECRET_KEY=mediguide123
S3_BUCKET=mediguide
S3_USE_SSL=false

EMBEDDING_PROVIDER=ollama
EMBEDDING_DIM=1024
CHUNK_SIZE=320
CHUNK_OVERLAP=60
MIN_CHUNK_CHARS=120
EMBEDDING_REQUEST_BATCH_SIZE=8
INGESTION_ARTIFACT_REUSE=false
INGESTION_PROCESSING_CONCURRENCY=false
PDF_PAGE_WORKERS=2
OCR_WORKERS=2
EMBEDDING_WORKERS=1
ARTIFACT_CACHE_EPOCH=1
# Required for hosted/local models without a resolvable Ollama digest.
EMBEDDING_CACHE_MODEL_REVISION=

LLM_PROVIDER=extractive
# Local host Ollama by default. For Docker Ollama later, use http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large:latest

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
