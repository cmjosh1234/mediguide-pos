# Environment settings grouped by responsibility.
# Credential values are preserved verbatim; do not commit populated private env files.

# Runtime and network bindings
API_HOST=0.0.0.0
APP_ENV=development
APP_NAME=mediguide-ai-worker
GRPC_HOST=0.0.0.0
HTTP_PORT=8090
LOG_LEVEL=INFO
WORKER_GRPC_PORT=50051

# Public web routes
ALLOWED_ORIGINS=http://localhost:3000

# Object storage and browser asset URLs
# S3_PUBLIC_ENDPOINT is a browser-reachable hostname[:port], without scheme or path.
# Production requires working DNS, TLS and an S3 API reverse proxy preserving Host/path/query.
# Keep S3_PUBLIC_SSL=true in production. Internal API storage traffic still uses minio:9000.
MAX_UPLOAD_BYTES=52428800
S3_ACCESS_KEY=mediguide
S3_BUCKET=mediguide
S3_ENDPOINT=localhost:9000
S3_SECRET_KEY=mediguide123
S3_USE_SSL=false

# Database connections
DATABASE_URL=postgresql://mediguide:mediguide@localhost:5432/mediguide
DB_STATEMENT_TIMEOUT_MS=30000

# Redis and response caching
REDIS_URL=redis://localhost:6379

# AI, search and model configuration
LLM_PROVIDER=extractive
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large:latest
OLLAMA_MODEL=qwen2.5:7b-instruct
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_MIN_SIMILARITY=0.15
RAG_NATIONAL_FIRST=true
RAG_TOP_K=6
WORKER_API_SECRET=

# Document ingestion and processing
ARTIFACT_CACHE_EPOCH=1
CHUNK_OVERLAP=60
CHUNK_SIZE=320
EMBEDDING_CACHE_MODEL_REVISION=
EMBEDDING_DIM=1024
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_PROVIDER=ollama
EMBEDDING_REQUEST_BATCH_SIZE=8
EMBEDDING_WORKERS=2
INGESTION_ARTIFACT_REUSE=true
INGESTION_HEARTBEAT_SECONDS=30
INGESTION_LEASE_SECONDS=120
INGESTION_PRIORITY_AGING_SECONDS=900
INGESTION_PROCESSING_CONCURRENCY=true
INGESTION_WORKER_CONCURRENCY=2
INGESTION_WORKER_ID=
MIN_CHUNK_CHARS=120
OCR_WORKERS=2
PDF_PAGE_WORKERS=2
WORKER_BATCH_SIZE=2
WORKER_ENABLED=true
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_RETRY_BACKOFF_SECONDS=30

# Build metadata
BUILD_REVISION=unknown
BUILD_VERSION=development
