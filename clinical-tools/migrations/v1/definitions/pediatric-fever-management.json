        "value": {
          "op": "field",
          "field": "danger_sign_count"
        }
      },
      {
        "key": "paracetamol_mg",
        "label": "Legacy paracetamol single dose",
        "value": {
          "op": "field",
          "field": "paracetamol_mg"
        },
        "unit": "mg"
      },
      {
        "key": "ibuprofen_mg",
        "label": "Legacy ibuprofen single dose",
        "value": {
          "op": "field",
          "field": "ibuprofen_mg"
        },
        "unit": "mg"
      }
