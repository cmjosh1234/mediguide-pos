        }
      },
      {
        "key": "age_months",
        "expression": {
          "op": "if",
          "args": [
            {
              "op": "equal",
              "args": [
                {
                  "op": "field",
                  "field": "age_unit"
                },
                {
                  "op": "literal",
                  "value": "years"
                }
              ]
            },
            {
              "op": "multiply",
              "args": [
                {
                  "op": "field",
                  "field": "age_value"
                },
                {
                  "op": "literal",
                  "value": 12
                }
              ]
            },
            {
              "op": "field",
              "field": "age_value"
            }
          ]
        }
      },
      {
        "key": "temperature_c",
        "expression": {
          "op": "field",
          "field": "temperature"
        },
        "precision": 1,
        "rounding_mode": "half_up"
      },
      {
        "key": "paracetamol_mg",
        "expression": {
          "op": "round",
          "precision": 0,
          "rounding_mode": "half_up",
          "args": [
            {
              "op": "multiply",
              "args": [
                {
                  "op": "field",
                  "field": "weight"
                },
                {
                  "op": "literal",
                  "value": 15
                }
              ]
            }
          ]
        }
      },
      {
        "key": "ibuprofen_mg",
        "expression": {
          "op": "round",
          "precision": 0,
          "rounding_mode": "half_up",
          "args": [
            {
              "op": "multiply",
              "args": [
                {
                  "op": "field",
                  "field": "weight"
                },
                {
                  "op": "literal",
                  "value": 10
                }
              ]
            }
          ]
        }
      }
    ],
    "rules": [],
    "outputs": [
      {
        "key": "age_months",
        "label": "Age in months",
        "value": {
          "op": "field",
          "field": "age_months"
