              "op": "literal",
              "value": 0
            }
          ]
        },
        "label": "HIGH RISK - Urgent Medical Attention",
        "description": "One or more recorded danger signs.",
        "severity": "critical",
        "recommendations": [
          "Seek urgent clinical assessment and monitor airway, breathing, and circulation."
        ],
        "order": 0
      },
