{
  "legacy_id": "pediatric-fever-management",
  "legacy_file": "pediatric-fever-management.html",
  "source_checksum": "db1ae667c44ebe12a1cd6227e9faa033e2cd04e07d56b1d02f96cdf7f244e39d",
  "change_summary": "Review draft: preserve age/temperature conversion and risk thresholds while requiring measured weight for any dose output and accepting an explicit age of zero months. All thresholds, danger signs, and doses require clinician/pharmacist approval. Named HTML controls and scored choices are preserved; aggregate counts/sign groups are derived from typed responses. Assign every field to its declared form section. Supersedes engineering review.1; remains unapproved. Complete HTML field and option coverage; preserve radio and multiline controls. Supersedes engineering review.2.",
  "definition": {
    "schema_version": "1.0",
    "tool_type": "decision_tool",
    "title": "Pediatric Fever Assessment",
    "description": "Classifies pediatric fever using age, temperature, and recorded danger signs. Review draft only; not approved for clinical publication.",
    "version": "1.0.0-review.3",
    "locale": "en",
    "supported_population": [
      "Children from birth through 18 years, subject to clinician confirmation"
    ],
    "exclusions": [
      "Do not delay urgent assessment to complete this tool."
    ],
    "warnings": [
      {
        "key": "urgent_warning",
        "text": "The recorded age, temperature, or danger signs meet a legacy urgent-assessment threshold. Seek urgent clinical care according to the approved local protocol.",
        "severity": "critical",
        "when": {
          "op": "or",
          "args": [
            {
              "op": "greater_than",
              "args": [
                {
                  "op": "field",
                  "field": "danger_sign_count"
                },
                {
                  "op": "literal",
                  "value": 0
                }
              ]
            },
            {
              "op": "and",
              "args": [
                {
                  "op": "less_than",
                  "args": [
                    {
                      "op": "field",
                      "field": "age_months"
                    },
                    {
                      "op": "literal",
                      "value": 3
                    }
                  ]
                },
                {
                  "op": "greater_than_or_equal",
                  "args": [
                    {
                      "op": "field",
                      "field": "temperature_c"
                    },
                    {
                      "op": "literal",
                      "value": 38
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "citations": [],
    "inputs": [
      {
        "key": "age_value",
        "type": "number",
        "label": "Age",
        "required": true,
        "minimum": 0,
        "maximum": 216,
        "section_key": "patient"
      },
      {
        "key": "age_unit",
        "type": "single_selection",
        "label": "Age unit",
        "required": true,
        "default": "months",
        "options": [
          {
            "value": "months",
            "label": "Months"
          },
          {
            "value": "years",
            "label": "Years"
          }
        ],
        "section_key": "patient",
        "control": "select"
      },
      {
        "key": "weight",
        "type": "measurement",
        "label": "Measured weight",
        "required": true,
        "minimum": 1,
        "maximum": 50,
        "allowed_units": [
          "kg"
        ],
        "default_unit": "kg",
        "section_key": "patient",
        "step": 0.1
      },
      {
        "key": "temperature",
        "type": "measurement",
        "label": "Temperature",
        "required": true,
        "minimum": 35,
        "maximum": 45,
        "allowed_units": [
          "celsius",
          "fahrenheit"
        ],
        "default_unit": "celsius",
        "section_key": "patient",
        "step": 0.1
      },
      {
        "key": "difficulty_breathing",
        "type": "boolean",
        "label": "Difficulty breathing or fast breathing",
        "required": false,
        "default": false,
        "section_key": "patient"
      },
      {
        "key": "poor_feeding",
        "type": "boolean",
        "label": "Poor feeding or refusing to drink",
        "required": false,
        "default": false,
        "section_key": "patient"
      },
      {
        "key": "vomiting",
        "type": "boolean",
        "label": "Persistent vomiting",
        "required": false,
        "default": false,
        "section_key": "patient"
      },
      {
        "key": "lethargy",
        "type": "boolean",
        "label": "Unusual sleepiness or difficulty waking",
        "required": false,
        "default": false,
        "section_key": "patient"
      },
      {
        "key": "irritability",
        "type": "boolean",
        "label": "Extreme irritability or inconsolable crying",
        "required": false,
        "default": false,
        "section_key": "patient"
      },
      {
        "key": "rash",
        "type": "boolean",
        "label": "Non-blanching rash (doesn't fade when pressed)",
        "required": false,
        "default": false,
        "section_key": "patient"
      },
      {
        "key": "neck_stiffness",
        "type": "boolean",
        "label": "Neck stiffness",
        "required": false,
        "default": false,
        "section_key": "patient"
      },
      {
        "key": "convulsions",
        "type": "boolean",
        "label": "Convulsions or seizures",
        "required": false,
        "default": false,
        "section_key": "patient"
      }
    ],
    "sections": [
      {
        "key": "patient",
        "title": "Child assessment",
        "order": 0,
        "review_before_completion": true
      }
    ],
    "calculation": [
      {
        "key": "danger_sign_count",
        "expression": {
          "op": "add",
          "args": [
            {
              "op": "if",
              "args": [
                {
                  "op": "field",
                  "field": "difficulty_breathing"
                },
                {
                  "op": "literal",
                  "value": 1
                },
                {
                  "op": "literal",
                  "value": 0
                }
              ]
            },
            {
              "op": "if",
              "args": [
                {
                  "op": "field",
                  "field": "poor_feeding"
                },
                {
                  "op": "literal",
                  "value": 1
                },
                {
                  "op": "literal",
                  "value": 0
                }
              ]
            },
            {
              "op": "if",
              "args": [
                {
                  "op": "field",
                  "field": "vomiting"
                },
                {
                  "op": "literal",
                  "value": 1
                },
                {
                  "op": "literal",
                  "value": 0
                }
              ]
            },
            {
              "op": "if",
              "args": [
                {
                  "op": "field",
                  "field": "lethargy"
                },
                {
                  "op": "literal",
                  "value": 1
                },
                {
                  "op": "literal",
                  "value": 0
                }
              ]
            },
            {
              "op": "if",
              "args": [
                {
                  "op": "field",
                  "field": "irritability"
                },
                {
                  "op": "literal",
                  "value": 1
                },
                {
                  "op": "literal",
                  "value": 0
                }
              ]
            },
            {
              "op": "if",
              "args": [
                {
                  "op": "field",
                  "field": "rash"
                },
                {
                  "op": "literal",
                  "value": 1
                },
                {
                  "op": "literal",
                  "value": 0
                }
              ]
            },
            {
              "op": "if",
              "args": [
                {
                  "op": "field",
                  "field": "neck_stiffness"
                },
                {
                  "op": "literal",
                  "value": 1
                },
                {
                  "op": "literal",
                  "value": 0
                }
              ]
            },
            {
              "op": "if",
              "args": [
                {
                  "op": "field",
                  "field": "convulsions"
                },
                {
                  "op": "literal",
                  "value": 1
                },
                {
                  "op": "literal",
                  "value": 0
                }
              ]
            }
