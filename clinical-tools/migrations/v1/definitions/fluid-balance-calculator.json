        "required": false,
        "minimum": 0,
        "maximum": 2000,
        "default": 800,
        "section_key": "output"
      },
      {
        "key": "other_losses",
        "type": "number",
        "label": "Other losses",
        "required": false,
        "minimum": 0,
        "maximum": 1000,
        "default": 0,
        "section_key": "output"
