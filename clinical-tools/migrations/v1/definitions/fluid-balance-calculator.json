                },
                {
                  "op": "literal",
                  "value": 500
                }
              ]
            },
            {
              "op": "less_than_or_equal",
              "args": [
                {
                  "op": "field",
                  "field": "net_balance"
                },
                {
                  "op": "literal",
                  "value": 1500
                }
              ]
            },
            {
              "op": "less_than_or_equal",
              "args": [
                {
                  "op": "field",
