        "key": "hour_17_20",
        "type": "integer",
        "label": "Hr 17-20:",
        "required": false,
        "minimum": 0,
        "section_key": "interval_urine",
        "default_unit": "mL",
        "help_text": "Recorded as assessment context; does not change the calculated result."
      },
      {
        "key": "hour_21_24",
        "type": "integer",
        "label": "Hr 21-24:",
        "required": false,
        "minimum": 0,
        "section_key": "interval_urine",
        "default_unit": "mL",
        "help_text": "Recorded as assessment context; does not change the calculated result."
