        "unit": "mL/kg",
        "precision": 1
      },
      {
        "key": "urine_per_kg_hour",
        "label": "Urine output",
        "value": {
          "op": "field",
          "field": "urine_per_kg_hour"
        },
        "unit": "mL/kg/hour",
        "precision": 2
