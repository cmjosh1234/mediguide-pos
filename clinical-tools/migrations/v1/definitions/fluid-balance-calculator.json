    "sections": [
      {
        "key": "patient",
        "title": "Patient",
        "order": 0
      },
      {
        "key": "intake",
        "title": "24-hour intake",
        "order": 1
      },
      {
        "key": "output",
        "title": "24-hour output",
        "order": 2,
        "review_before_completion": true
      },
      {
        "key": "interval_urine",
        "title": "Interval urine output",
        "order": 3
      }
    ],
    "calculation": [
      {
        "key": "total_intake",
        "expression": {
          "op": "add",
          "args": [
            {
              "op": "field",
              "field": "oral_fluids"
            },
            {
              "op": "field",
              "field": "iv_fluids"
            },
            {
              "op": "field",
              "field": "tube_feeding"
            },
            {
              "op": "field",
              "field": "food_moisture"
            },
            {
              "op": "field",
              "field": "medications"
            }
          ]
        }
      },
      {
        "key": "total_output",
        "expression": {
          "op": "add",
          "args": [
            {
              "op": "field",
              "field": "urine_output"
            },
            {
              "op": "field",
              "field": "vomiting"
            },
            {
              "op": "field",
              "field": "diarrhea"
            },
            {
              "op": "field",
              "field": "drainage"
            },
            {
              "op": "field",
              "field": "insensible"
            },
            {
              "op": "field",
              "field": "other_losses"
            }
          ]
        }
      },
      {
        "key": "net_balance",
        "expression": {
          "op": "subtract",
          "args": [
            {
              "op": "field",
              "field": "total_intake"
            },
            {
              "op": "field",
              "field": "total_output"
            }
          ]
        }
      },
      {
        "key": "balance_per_kg",
        "expression": {
          "op": "round",
          "precision": 1,
          "rounding_mode": "half_up",
          "args": [
            {
              "op": "divide",
              "args": [
                {
                  "op": "field",
                  "field": "net_balance"
                },
                {
                  "op": "field",
                  "field": "weight"
                }
              ]
            }
          ]
        }
      },
      {
        "key": "urine_per_kg_hour",
        "expression": {
          "op": "round",
          "precision": 2,
          "rounding_mode": "half_up",
          "args": [
            {
              "op": "divide",
              "args": [
                {
                  "op": "field",
                  "field": "urine_output"
                },
                {
                  "op": "multiply",
                  "args": [
                    {
                      "op": "field",
                      "field": "weight"
                    },
                    {
                      "op": "literal",
                      "value": 24
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "rules": [],
    "outputs": [
      {
        "key": "total_intake",
        "label": "Total intake",
        "value": {
          "op": "field",
          "field": "total_intake"
        },
        "unit": "mL"
      },
      {
        "key": "total_output",
        "label": "Total output",
        "value": {
          "op": "field",
          "field": "total_output"
        },
        "unit": "mL"
      },
      {
        "key": "net_balance",
