{
  "legacy_id": "fluid-balance-calculator",
  "legacy_file": "fluid-balance-calculator.html",
  "source_checksum": "6aaf110ccee6d2032c0ada4a16e60c7247641372317e69f7bead65cb9269f090",
  "change_summary": "Review draft: preserve 24-hour intake/output totals, balance thresholds, age-adjusted urine threshold, and condition selection. Age zero is rejected and clinical recommendations require approval. Assign every field to its declared form section. Supersedes engineering review.1; remains unapproved. Complete HTML field and option coverage; preserve radio and multiline controls. Supersedes engineering review.2.",
  "definition": {
    "schema_version": "1.0",
    "tool_type": "calculator",
    "title": "Fluid Balance Calculator",
    "description": "Summarizes recorded 24-hour fluid intake and output. Review draft only; not approved for clinical publication.",
    "version": "1.0.0-review.3",
    "locale": "en",
    "supported_population": [],
    "exclusions": [
      "Do not infer fluid status from this calculation without clinical assessment."
    ],
    "warnings": [
      {
        "key": "critical_oliguria",
        "text": "Critically low recorded urine output requires immediate clinical assessment.",
        "severity": "critical",
        "when": {
          "op": "less_than",
          "args": [
            {
              "op": "field",
              "field": "urine_per_kg_hour"
            },
            {
              "op": "literal",
              "value": 0.3
            }
          ]
        }
      },
      {
        "key": "significant_imbalance",
        "text": "The recorded balance meets a legacy significant fluid-imbalance threshold and requires clinical review.",
        "severity": "critical",
        "when": {
          "op": "or",
          "args": [
            {
              "op": "greater_than",
              "args": [
                {
                  "op": "field",
                  "field": "net_balance"
                },
                {
                  "op": "literal",
                  "value": 1500
                }
              ]
            },
            {
              "op": "greater_than",
              "args": [
                {
                  "op": "field",
                  "field": "balance_per_kg"
                },
                {
                  "op": "literal",
                  "value": 20
                }
              ]
            },
            {
              "op": "less_than",
              "args": [
                {
                  "op": "field",
                  "field": "net_balance"
                },
                {
                  "op": "literal",
                  "value": -1500
                }
              ]
            },
            {
              "op": "less_than",
              "args": [
                {
                  "op": "field",
                  "field": "balance_per_kg"
                },
                {
                  "op": "literal",
                  "value": -20
                }
              ]
            }
          ]
        }
      }
    ],
    "citations": [],
    "inputs": [
      {
        "key": "weight",
        "type": "measurement",
        "label": "Weight",
        "required": true,
        "minimum": 1,
        "maximum": 300,
        "allowed_units": [
          "kg"
        ],
        "default_unit": "kg",
        "section_key": "patient",
        "step": 0.1
      },
      {
        "key": "age",
        "type": "integer",
        "label": "Age",
        "required": true,
        "minimum": 1,
        "maximum": 120,
        "section_key": "patient"
      },
      {
        "key": "clinical_condition",
        "type": "single_selection",
        "label": "Clinical condition",
        "required": true,
        "default": "normal",
        "options": [
          {
            "value": "normal",
            "label": "Normal/Stable"
          },
          {
            "value": "heart_failure",
            "label": "Heart Failure"
          },
          {
            "value": "kidney_disease",
            "label": "Kidney Disease"
          },
          {
            "value": "liver_disease",
            "label": "Liver Disease"
          },
          {
            "value": "diabetes",
            "label": "Diabetes"
          },
          {
            "value": "surgery",
            "label": "Post-Surgical"
          },
          {
            "value": "fever",
            "label": "Fever/Infection"
          },
          {
            "value": "burns",
            "label": "Burns"
          },
          {
            "value": "pregnancy",
            "label": "Pregnancy"
          }
        ],
        "section_key": "patient",
        "control": "select"
      },
      {
        "key": "oral_fluids",
        "type": "number",
        "label": "Oral fluids",
        "required": false,
        "minimum": 0,
        "maximum": 10000,
        "default": 0,
        "section_key": "intake"
      },
      {
        "key": "iv_fluids",
        "type": "number",
        "label": "IV fluids",
        "required": false,
        "minimum": 0,
        "maximum": 5000,
        "default": 0,
