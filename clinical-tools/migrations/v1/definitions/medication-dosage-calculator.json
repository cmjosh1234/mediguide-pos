        "text": "The medication presets and limits are unapproved legacy values. Verify independently with an authorized pharmacist and current formulary.",
        "severity": "critical"
      },
      {
        "key": "aspirin_child",
        "text": "The legacy tool blocks aspirin for patients under 18. Follow an approved pediatric protocol and obtain pharmacist/clinician review.",
        "severity": "critical",
        "when": {
          "op": "and",
          "args": [
            {
              "op": "equal",
              "args": [
                {
                  "op": "field",
                  "field": "medication"
                },
                {
                  "op": "literal",
                  "value": "aspirin"
                }
              ]
            },
            {
              "op": "less_than",
              "args": [
                {
                  "op": "field",
                  "field": "age_years"
                },
                {
                  "op": "literal",
                  "value": 18
                }
              ]
            }
          ]
        }
      },
      {
        "key": "single_cap",
