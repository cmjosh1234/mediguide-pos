  "change_summary": "Review draft: represent Numeric, FACES, BPS, FLACC, and PQRST branches with typed conditional inputs and require every component used by the selected scale. Management wording and completeness rules require clinician approval. Named HTML controls and scored choices are preserved; aggregate counts/sign groups are derived from typed responses. Assign every field to its declared form section. Supersedes engineering review.1; remains unapproved. Complete HTML field and option coverage; preserve radio and multiline controls. Supersedes engineering review.2.",
  "definition": {
    "schema_version": "1.0",
    "tool_type": "calculator",
    "title": "Pain Assessment",
    "description": "Records a selected pain scale and classifies its score. Review draft only; not approved for clinical publication.",
    "version": "1.0.0-review.3",
    "locale": "en",
    "supported_population": [],
    "exclusions": [
      "Select a scale appropriate to the patient's age, communication ability, and clinical context."
    ],
    "warnings": [
