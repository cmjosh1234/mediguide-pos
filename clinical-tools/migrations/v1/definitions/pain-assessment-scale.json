            {
              "op": "greater_than_or_equal",
              "args": [
                {
                  "op": "field",
                  "field": "score"
                },
                {
                  "op": "literal",
                  "value": 7
                }
              ]
            }
          ]
        }
      }
    ],
    "citations": [],
