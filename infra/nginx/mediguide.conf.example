# Install as /etc/nginx/conf.d/mediguide.conf (or the distribution-equivalent
# site file), replace the hostname and certificate paths, then run nginx -t.

server {
    listen 80;
    listen [::]:80;
    server_name mediguide.example.org;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mediguide.example.org;

    ssl_certificate /etc/letsencrypt/live/mediguide.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mediguide.example.org/privkey.pem;

    client_max_body_size 100m;

    # Structured guideline snapshots can be large. Compress proxied API JSON as
    # well as the public application's static JavaScript and styles.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    # The book reader downloads the published Markdown directly. Include its
    # MIME type explicitly; Nginx does not compress text/markdown by default and
    # national guidelines can otherwise transfer several megabytes uncompressed.
    gzip_types text/plain text/css text/markdown application/markdown application/json application/javascript image/svg+xml;

    # Next.js is built with basePath=/admin. Preserve the prefix: a trailing
    # slash on proxy_pass here would strip it and break routes and static assets.
    location = /admin {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location ^~ /admin/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # The browser-visible API base is the origin (https://this-host), while
    # typed clients append /api/v2/... to it.
    location = /api/metrics {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
    }

    location = /api {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /swagger/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Guidelines owns the public site and every remaining route.
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
