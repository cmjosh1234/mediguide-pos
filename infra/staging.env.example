# Copy to infra/staging.env and replace every staging value.
# The key set intentionally matches development.env and production.env.example.
APP_ENV=staging
PUBLIC_BIND_ADDRESS=0.0.0.0
DEV_DATA_BIND_ADDRESS=127.0.0.1
REDIS_KEY_PREFIX=mediguide:staging
REDIS_MAXMEMORY=256mb

REDIS_MAXMEMORY_POLICY=noeviction
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_READ_TIMEOUT_MS=1000
REDIS_WRITE_TIMEOUT_MS=1000
RATE_LIMIT_ENABLED=true

# Notification abuse-control overrides. Keep urgent campaign limits stricter
# than their normal equivalents.
RATE_LIMIT_FIREBASE_TEST_PUSH_LIMIT=10
RATE_LIMIT_FIREBASE_TEST_PUSH_WINDOW_SECONDS=3600
RATE_LIMIT_NOTIFICATION_PUBLICATION_LIMIT=20
RATE_LIMIT_NOTIFICATION_URGENT_PUBLICATION_LIMIT=3
RATE_LIMIT_NOTIFICATION_CAMPAIGN_CREATION_LIMIT=10
RATE_LIMIT_NOTIFICATION_URGENT_CAMPAIGN_CREATION_LIMIT=3
RATE_LIMIT_NOTIFICATION_CAMPAIGN_APPROVAL_LIMIT=20
RATE_LIMIT_NOTIFICATION_URGENT_CAMPAIGN_APPROVAL_LIMIT=3
RATE_LIMIT_NOTIFICATION_CAMPAIGN_SCHEDULING_LIMIT=10
RATE_LIMIT_NOTIFICATION_URGENT_CAMPAIGN_SCHEDULING_LIMIT=3
RATE_LIMIT_NOTIFICATION_DELIVERY_REQUEUE_LIMIT=20
RATE_LIMIT_NOTIFICATION_AUDIENCE_ESTIMATE_LIMIT=60
RATE_LIMIT_FIREBASE_REMOTE_CONFIG_WRITE_LIMIT=10
RATE_LIMIT_NOTIFICATION_DELIVERY_EVENT_LIMIT=120
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MAX_ITEM_BYTES=1048576
TRUSTED_PROXIES=
NOTIFICATION_ACTION_EXTERNAL_HOSTS=staging.mediguide.health.go.ug,mediguide.health.go.ug,health.go.ug,www.health.go.ug,who.int,www.who.int,afro.who.int,www.afro.who.int,iris.who.int

# Pin these image tags to the staging release under test.
API_IMAGE=ghcr.io/mohuganda/mediguide-pos-api:staging
AI_WORKER_IMAGE=ghcr.io/mohuganda/mediguide-pos-ai-worker:staging
DASHBOARD_IMAGE=ghcr.io/mohuganda/mediguide-pos-dashboard:staging
GUIDELINES_IMAGE=ghcr.io/mohuganda/mediguide-pos-guidelines:staging
GUIDELINES_DEV_IMAGE=mediguide-guidelines:development
DASHBOARD_DEV_IMAGE=mediguide-dashboard:development

# Production-only deployment hook; keep disabled in staging.
GUIDELINE_ASSET_IMPORT_ENABLED=0
GUIDELINE_ASSET_IMPORT_VERSION_ID=
GUIDELINE_ASSET_IMPORT_SCRIPT=asset-import/scripts/import-guideline-assets.sh
GUIDELINE_ASSET_IMPORT_MANIFEST=asset-import/scripts/manifests/ucg-2023-assets.json
GUIDELINE_ASSET_IMPORT_TOKEN_FILE=/run/secrets/mediguide-guideline-asset-import.token
GUIDELINE_ASSET_IMPORT_REGENERATE=1
GUIDELINE_ASSET_IMPORT_TIMEOUT_SECONDS=1800

POSTGRES_DB=mediguide
POSTGRES_USER=mediguide
POSTGRES_PASSWORD=replace-with-a-strong-staging-database-password
POSTGRES_PUBLIC_PORT=5433
DATABASE_URL=postgres://mediguide:replace-with-a-strong-staging-database-password@postgres:5432/mediguide?sslmode=disable
AI_DATABASE_URL=postgresql://mediguide:replace-with-a-strong-staging-database-password@postgres:5432/mediguide

MINIO_ROOT_USER=replace-with-a-staging-storage-access-key
MINIO_ROOT_PASSWORD=replace-with-a-strong-staging-storage-secret
MINIO_PUBLIC_PORT=9000
MINIO_CONSOLE_PUBLIC_PORT=9001
S3_BUCKET=mediguide

JWT_SECRET=replace-with-a-long-random-staging-jwt-secret
JWT_ISSUER=mediguide-staging
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_MINUTES=43200
DEFAULT_ADMIN_NAME=MediGuide Staging Administrator
DEFAULT_ADMIN_EMAIL=admin@staging.example.org
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-staging-admin-password

API_PUBLIC_PORT=8080
PUBLIC_SITE_URL=https://staging.mediguide.health.go.ug
PUBLIC_API_BASE_URL=https://staging.mediguide.health.go.ug
ALLOWED_ORIGINS=https://staging.mediguide.health.go.ug
DASHBOARD_PUBLIC_PORT=3000
DASHBOARD_BASE_PATH=/admin
DASHBOARD_PUBLIC_URL=https://staging.mediguide.health.go.ug/admin/login

MAIL_DRIVER=smtp
MAIL_FROM=no-reply@staging.example.org
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=replace-with-staging-smtp-username
SMTP_PASSWORD=replace-with-staging-smtp-password

# Present for schema parity; only the development override consumes it.
CHOKIDAR_USEPOLLING=true

# AI/RAG runtime tuning.
AI_WORKER_TIMEOUT_SECONDS=120
RAG_CANDIDATE_K=24
RAG_CONTEXT_K=6
RAG_MIN_SIMILARITY=0.25
RAG_COUNTRY_BOOST=0.05
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large:latest
OLLAMA_TEMPERATURE=0
OLLAMA_TOP_P=0.9
OLLAMA_SEED=42
OLLAMA_NUM_CTX=8192

# Firebase Admin credentials are backend-only. This variable contains the
# one-line Base64 value, never a path to a JSON or .base64 file.
FIREBASE_PROJECT_ID=mediguide-staging
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_DEVICE_STALE_DAYS=90
NOTIFICATION_WORKER_PORT=8082
NOTIFICATION_WORKER_BATCH_SIZE=75
NOTIFICATION_WORKER_CONCURRENCY=8
NOTIFICATION_WORKER_POLL_MS=1000
NOTIFICATION_WORKER_MAX_AGE_HOURS=168
NOTIFICATION_WORKER_LEASE_SECONDS=120
GUIDELINES_PUBLIC_PORT=5000

BUILD_VERSION=staging
BUILD_REVISION=unknown
