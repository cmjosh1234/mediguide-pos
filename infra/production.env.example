# Copy to infra/production.env and replace every production value.
# Public HTTP services bind on every server interface; restrict them with the firewall.
APP_ENV=production
PUBLIC_BIND_ADDRESS=0.0.0.0
DEV_DATA_BIND_ADDRESS=127.0.0.1
REDIS_KEY_PREFIX=mediguide:production
REDIS_MAXMEMORY=512mb

# noeviction protects quota continuity when cache and limiter share Redis.
REDIS_MAXMEMORY_POLICY=noeviction
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_READ_TIMEOUT_MS=1000
REDIS_WRITE_TIMEOUT_MS=1000
RATE_LIMIT_ENABLED=true

# Notification abuse-control overrides. Defaults are also enforced in code;
# keep urgent campaign limits stricter than their normal equivalents.
RATE_LIMIT_FIREBASE_TEST_PUSH_LIMIT=10
RATE_LIMIT_FIREBASE_TEST_PUSH_WINDOW_SECONDS=3600
RATE_LIMIT_NOTIFICATION_PUBLICATION_LIMIT=20
RATE_LIMIT_NOTIFICATION_URGENT_PUBLICATION_LIMIT=3
RATE_LIMIT_NOTIFICATION_CAMPAIGN_CREATION_LIMIT=10
RATE_LIMIT_NOTIFICATION_URGENT_CAMPAIGN_CREATION_LIMIT=3
RATE_LIMIT_NOTIFICATION_CAMPAIGN_APPROVAL_LIMIT=20
RATE_LIMIT_NOTIFICATION_URGENT_CAMPAIGN_APPROVAL_LIMIT=3
RATE_LIMIT_NOTIFICATION_CAMPAIGN_SCHEDULING_LIMIT=10
RATE_LIMIT_NOTIFICATION_URGENT_CAMPAIGN_SCHEDULING_LIMIT=3
RATE_LIMIT_NOTIFICATION_DELIVERY_REQUEUE_LIMIT=20
RATE_LIMIT_NOTIFICATION_AUDIENCE_ESTIMATE_LIMIT=60
RATE_LIMIT_FIREBASE_REMOTE_CONFIG_WRITE_LIMIT=10
RATE_LIMIT_NOTIFICATION_DELIVERY_EVENT_LIMIT=120
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MAX_ITEM_BYTES=1048576
# Add only reverse-proxy CIDRs controlled by the deployment.
TRUSTED_PROXIES=
NOTIFICATION_ACTION_EXTERNAL_HOSTS=mediguide.health.go.ug,health.go.ug,www.health.go.ug,who.int,www.who.int,afro.who.int,www.afro.who.int,iris.who.int

# First-party images published by .github/workflows/container-images.yml.
# Replace `replace-with-github-owner` with the lowercase GitHub account or
# organization that owns this repository.
API_IMAGE=ghcr.io/replace-with-github-owner/mediguide-pos-api:latest
AI_WORKER_IMAGE=ghcr.io/replace-with-github-owner/mediguide-pos-ai-worker:latest
DASHBOARD_IMAGE=ghcr.io/replace-with-github-owner/mediguide-pos-dashboard:latest
GUIDELINES_IMAGE=ghcr.io/replace-with-github-owner/mediguide-pos-guidelines:latest
GUIDELINES_DEV_IMAGE=mediguide-guidelines:development
DASHBOARD_DEV_IMAGE=mediguide-dashboard:development

# Optional one-time governed guideline image import after a healthy deployment.
# Keep disabled until the target draft, manifest, and short-lived token file
# have been prepared on the production host. The importer never reviews or
# publishes clinical content.
GUIDELINE_ASSET_IMPORT_ENABLED=0
GUIDELINE_ASSET_IMPORT_VERSION_ID=
GUIDELINE_ASSET_IMPORT_SCRIPT=asset-import/scripts/import-guideline-assets.sh
GUIDELINE_ASSET_IMPORT_MANIFEST=asset-import/scripts/manifests/ucg-2023-assets.json
GUIDELINE_ASSET_IMPORT_TOKEN_FILE=/run/secrets/mediguide-guideline-asset-import.token
GUIDELINE_ASSET_IMPORT_REGENERATE=1
GUIDELINE_ASSET_IMPORT_TIMEOUT_SECONDS=1800

POSTGRES_DB=mediguide
POSTGRES_USER=mediguide
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PUBLIC_PORT=5433
DATABASE_URL=postgres://mediguide:replace-with-a-strong-database-password@postgres:5432/mediguide?sslmode=disable
AI_DATABASE_URL=postgresql://mediguide:replace-with-a-strong-database-password@postgres:5432/mediguide

MINIO_ROOT_USER=replace-with-a-storage-access-key
MINIO_ROOT_PASSWORD=replace-with-a-strong-storage-secret
MINIO_PUBLIC_PORT=9000
MINIO_CONSOLE_PUBLIC_PORT=9001
S3_BUCKET=mediguide

JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_ISSUER=mediguide-production
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_MINUTES=43200
DEFAULT_ADMIN_NAME=MediGuide Administrator
DEFAULT_ADMIN_EMAIL=admin@example.org
# Used only when creating the admin or when an explicit reset is requested.
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password

API_PUBLIC_PORT=8080
# Browser-visible origin serving Guidelines at / and proxying /api to the API.
PUBLIC_SITE_URL=https://mediguide.example.org
PUBLIC_API_BASE_URL=https://mediguide.example.org
ALLOWED_ORIGINS=https://mediguide.example.org
DASHBOARD_PUBLIC_PORT=3000
DASHBOARD_BASE_PATH=/admin
DASHBOARD_PUBLIC_URL=https://mediguide.example.org/admin/login

# Account recovery and verification email. Production should use `smtp`.
MAIL_DRIVER=smtp
MAIL_FROM=no-reply@example.org
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password

# Development-only file watching is inert in the production Compose file but
# remains present so every infrastructure environment has the same schema.
CHOKIDAR_USEPOLLING=true

# AI/RAG runtime tuning.
AI_WORKER_TIMEOUT_SECONDS=120
RAG_CANDIDATE_K=24
RAG_CONTEXT_K=6
RAG_MIN_SIMILARITY=0.25
RAG_COUNTRY_BOOST=0.05
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large:latest
OLLAMA_TEMPERATURE=0
OLLAMA_TOP_P=0.9
OLLAMA_SEED=42
OLLAMA_NUM_CTX=8192

# Firebase Admin credentials are backend-only. Encode the complete service
# account JSON with: base64 < service-account.json | tr -d '\n'
FIREBASE_PROJECT_ID=mediguide-production
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_DEVICE_STALE_DAYS=90
NOTIFICATION_WORKER_PORT=8082
NOTIFICATION_WORKER_BATCH_SIZE=100
NOTIFICATION_WORKER_CONCURRENCY=10
NOTIFICATION_WORKER_POLL_MS=1000
NOTIFICATION_WORKER_MAX_AGE_HOURS=168
NOTIFICATION_WORKER_LEASE_SECONDS=120
GUIDELINES_PUBLIC_PORT=5000

BUILD_VERSION=development
BUILD_REVISION=unknown
