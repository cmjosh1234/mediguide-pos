# Environment settings grouped by responsibility.
# Credential values are preserved verbatim; do not commit populated private env files.

# Runtime and network bindings
APP_ENV=development
APP_NAME=mediguide-backend
HTTP_PORT=8080
LEGACY_CLINICAL_TOOLS_DIR=../dashboard/samples
TRUSTED_PROXIES=

# Public web routes
ALLOWED_ORIGINS=http://localhost:3000,*
PUBLIC_APP_URL=http://localhost:3000/admin

# Object storage and browser asset URLs
# S3_PUBLIC_ENDPOINT is a browser-reachable hostname[:port], without scheme or path.
# Production requires working DNS, TLS and an S3 API reverse proxy preserving Host/path/query.
# Keep S3_PUBLIC_SSL=true in production. Internal API storage traffic still uses minio:9000.
GUIDELINE_DIRECT_UPLOADS=false
MAX_UPLOAD_MB=100
S3_ACCESS_KEY=mediguide
S3_BUCKET=mediguide
S3_ENDPOINT=localhost:9000
S3_PRESIGN_MINUTES=60
S3_PUBLIC_ENDPOINT=localhost:9000
S3_PUBLIC_SSL=false
S3_SECRET_KEY=mediguide123
S3_USE_SSL=false
STORAGE_DRIVER=minio

# Database connections
DATABASE_URL=postgres://mediguide:mediguide@localhost:5432/mediguide?sslmode=disable

# Authentication and initial administrator
ACCOUNT_ACTION_URL=${PUBLIC_APP_URL}
DEFAULT_ADMIN_EMAIL=admin@mediguide.local
DEFAULT_ADMIN_NAME=MediGuide Administrator
DEFAULT_ADMIN_PASSWORD=Admin123!
JWT_ACCESS_TTL_MINUTES=60
JWT_ISSUER=mediguide
JWT_REFRESH_TTL_MINUTES=43200
JWT_SECRET=change-this-secret-ernrjtjtpckrmcjwieutalldjjr8373n1y1y2n2y3y4bdnzmzmz2u

# Account email delivery
# MAIL_DRIVER: disabled, development (non-production), smtp, or resend (HTTPS API).
# Resend requires a verified sender in MAIL_FROM and a private RESEND_API_KEY.
MAIL_DRIVER=disabled
MAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_USERNAME=

# Firebase and notification worker
# Service-account credentials stay backend-only; use encoded JSON, not a filename.
FIREBASE_DEVICE_STALE_DAYS=90
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=
NOTIFICATION_ACTION_EXTERNAL_HOSTS=mediguide.health.go.ug,health.go.ug,www.health.go.ug,who.int,www.who.int,afro.who.int,www.afro.who.int,iris.who.int
NOTIFICATION_WORKER_BATCH_SIZE=100
NOTIFICATION_WORKER_CONCURRENCY=10
NOTIFICATION_WORKER_LEASE_SECONDS=120
NOTIFICATION_WORKER_MAX_AGE_HOURS=168
NOTIFICATION_WORKER_POLL_MS=1000
NOTIFICATION_WORKER_PORT=8082

# Redis and response caching
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_ENABLED=true
CACHE_MAX_ITEM_BYTES=1048576
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_KEY_PREFIX=mediguide:development
REDIS_READ_TIMEOUT_MS=1000
REDIS_URL=redis://localhost:6379
REDIS_WRITE_TIMEOUT_MS=1000

# Rate limits
RATE_LIMIT_ENABLED=true

# AI, search and model configuration
AI_RAG_PROVIDER=local
AI_WORKER_GRPC_ADDR=localhost:50051
AI_WORKER_GRPC_HEALTH_TIMEOUT_SECONDS=2
AI_WORKER_GRPC_RETRIES=1
AI_WORKER_SECRET=
AI_WORKER_TIMEOUT_SECONDS=120
