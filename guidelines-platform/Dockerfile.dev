# syntax=docker/dockerfile:1.7

FROM node:22.18.0-alpine3.22 AS runtime

WORKDIR /app

COPY guidelines-platform/package.json guidelines-platform/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

COPY guidelines-platform/ ./

ENV NODE_ENV=development
ENV VITE_HOST=0.0.0.0
ENV VITE_PORT=8080

RUN chown -R node:node /app
USER node

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
  CMD wget -qO- "http://127.0.0.1:${VITE_PORT}/" >/dev/null || exit 1

# The compose development profile bind-mounts the source tree and a persistent
# node_modules volume. Its command reconciles that volume with package-lock.json
# before starting Vite so newly-added dependencies are available immediately.
CMD ["sh", "-c", "npm run content:manifest && exec npm run dev -- --host \"${VITE_HOST}\" --port \"${VITE_PORT}\""]
