{
  "name": "guidelines-platform",
  "private": true,
  "version": "2.1.5",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "content:manifest": "node scripts/generate-content-manifest.mjs",
    "build": "tsc -b && vite build",
    "format:markdown": "node scripts/format-markdown.mjs",
    "migration:report": "node scripts/report-static-migration.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run lint && npm run test && npm run build",
    "release:prepare": "node ../scripts/prepare-release.js",
    "release:check": "bash ../scripts/check-release-readiness.sh",
    "preview": "vite preview"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "^3.2.4",
    "vite": "^8.1.1"
  }
}
